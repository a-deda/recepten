# ---------------------------------------------------------------------------
# Frontend (Vite: alleen VITE_*-variabelen komen in de browserbundel terecht)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# De "publishable" key uit het Supabase-dashboard (heette vroeger anon).
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# Netlify functions (server-side; NOOIT met VITE_ prefix)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# De "secret" key uit het dashboard (heette vroeger service_role). Omzeilt RLS.
# Alleen in Netlify env-vars en Apps Script Script Properties. Niet in de
# frontend, niet in git.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
ANTHROPIC_API_KEY=sk-ant-...
# Gedeeld geheim tussen Apps Script en /api/intake. Genereer met:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTAKE_SECRET=
# uuid van je Supabase-gebruiker (auth.users.id). Alle recepten krijgen deze owner.
OWNER_ID=00000000-0000-0000-0000-000000000000
# Optioneel: ander model voor de parser. Standaard claude-opus-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Alleen voor scripts/parse-eval.ts en scripts/send-test-intake.ts
# ---------------------------------------------------------------------------
INTAKE_URL=http://localhost:8888/api/intake

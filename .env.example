# ---------------------------------------------------------------------------
# Frontend (Vite: alleen VITE_*-variabelen komen in de browserbundel terecht)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Netlify functions (server-side; NOOIT met VITE_ prefix)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key: omzeilt RLS. Alleen in Netlify env-vars en Apps Script
# Script Properties. Niet in de frontend, niet in git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
ANTHROPIC_API_KEY=sk-ant-...
# Gedeeld geheim tussen Apps Script en /api/intake. Genereer met:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTAKE_SECRET=
# uuid van je Supabase-gebruiker (auth.users.id). Alle recepten krijgen deze owner.
OWNER_ID=00000000-0000-0000-0000-000000000000
# Publieke URL van de site, gebruikt door de worker om zichzelf te pokén.
SITE_URL=https://receptenbak.netlify.app

# ---------------------------------------------------------------------------
# Alleen voor scripts/parse-eval.ts en scripts/send-test-intake.ts
# ---------------------------------------------------------------------------
INTAKE_URL=http://localhost:8888/api/intake
